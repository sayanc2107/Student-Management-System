# ==============================================================================
# T5 ERP SYSTEM - ENVIRONMENT CONFIGURATION (SAMPLE / TEMPLATE)
# ==============================================================================
# Copy this file to '.env' for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# Never commit '.env' to source control.

# Application Environment (development, production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Note: On Render, PORT is provided automatically by the platform environment.

# JWT Authentication Secret Key
# Generate a cryptographically secure 32+ character random string in production
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_32_character_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
# Password characters must be URL-encoded if containing symbols (@, :, /, #, etc.)
MONGODB_URI=mongodb+srv://tuition_user:your_password_here@cluster0.example.mongodb.net/tuition_db?retryWrites=true&w=majority
DATABASE_NAME=tuition_db

# Timezone & Currency
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# Teacher & Tuition Profile
TEACHER_NAME=Dr. Rajesh Sharma
TEACHER_EMAIL=teacher@example.com
TEACHER_PHONE=+91 98765 43210
TEACHER_WHATSAPP=+91 98765 43210
TUITION_NAME=T5 ERP SYSTEM
TUITION_ADDRESS=Flat 302, Sunrise Heights, 15th Cross, Malleshwaram, Bengaluru 560003

# Direct UPI Payment Details (Shown to students on billing ledger)
TEACHER_UPI_ID=sayan2008c@pthdfc
TEACHER_UPI_NAME=Sayan
TEACHER_UPI_QR_URL=

# Demo Data Setting:
# NEVER set to true in production. Run 'python seed.py' to seed or 'python seed.py --remove' to clear.
ENABLE_DEMO_SEED=false
