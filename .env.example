# ==============================================================================
# STUDENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Secret Key for JWT Token Generation (Use a strong random 32+ character string in production)
JWT_SECRET_KEY=dev_secret_key_tuition_student_mgmt_change_in_production_9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/tuition_db?retryWrites=true&w=majority
DATABASE_NAME=tuition_db

# Timezone & Currency
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# Teacher & Tuition Profile
TEACHER_NAME=Dr. Rajesh Sharma
TEACHER_EMAIL=rajesh.sharma.tuitions@gmail.com
TEACHER_PHONE=+91 98765 43210
TEACHER_WHATSAPP=+91 98765 43210
TUITION_NAME=T5 ERP SYSTEM
TUITION_ADDRESS=Flat 302, Sunrise Heights, 15th Cross, Malleshwaram, Bengaluru 560003

# Direct UPI Payment Details (Shown to students for manual direct payments)
TEACHER_UPI_ID=sayan2008c@pthdfc
TEACHER_UPI_NAME=Sayan
# Optional static QR code image URL or base64 (if blank, dynamic UPI QR is generated on the client)
TEACHER_UPI_QR_URL=

# Demo Mode: if true, preloads demo data if collections are empty
ENABLE_DEMO_SEED=true
